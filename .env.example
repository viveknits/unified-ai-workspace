# Copy to .env and fill in whatever you have. Any provider whose key is
# missing is simply not registered at startup, so the app runs with none set.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier models available: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
